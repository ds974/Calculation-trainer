# --- Base de données SQLite et fichiers auxiliaires ---
storage/*.sqlite
storage/*.sqlite-wal
storage/*.sqlite-shm
storage/*.sqlite-journal

# --- Fichiers de configuration contenant des secrets ---
.env
*.secret
config/*.local.php

# --- Journaux et fichiers temporaires ---
*.log
*.tmp
.DS_Store
*.swp

# --- Fichiers de sortie temporaires des tests ---
tests/.http_out.txt
tests/*.out.txt

# --- Données personnelles / téléversements éventuels ---
# (aucun répertoire de données utilisateur doit être versionné)

# --- Divers ---
node_modules/
# Ne pas versionner un éventuel répertoire « vendor/ » à la racine (ex. Composer),
# mais CONSERVER public/vendor/ (bibliothèques front localisées, ex. Chart.js).
/vendor/
